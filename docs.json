{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nominal Instrumentation",
  "colors": {
    "primary": "#0B0B0B",
    "light": "#FFFFFF",
    "dark": "#0B0B0B"
