        {
          "anchor": "Examples",
          "href": "https://nominal-io.github.io/instrumentation-docs/examples/",
          "icon": "code"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/nominal-io",
          "icon": "github"
        }
      ]
    }
