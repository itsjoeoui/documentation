{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nominal Instrumentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Instrumentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "instrumentation/overview",
              "instrumentation/scope",
              "instrumentation/installation",
              "instrumentation/driver-dependencies",
              "instrumentation/examples"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "instrumentation/publishers",
              "instrumentation/library"
            ]
          },
          {
            "group": "Instruments",
            "pages": [
              "instrumentation/psu",
              "instrumentation/eload",
              "instrumentation/dmm",
              "instrumentation/daq",
              {
                "group": "I2C",
                "pages": [
                  "instrumentation/i2c/overview",
                  "instrumentation/i2c/system-definition"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/components",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "Agent ready",
            "pages": [
              "agent-ready/prompt",
              "agent-ready/visibility",
              "agent-ready/contextual",
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "SDK Reference",
          "href": "https://nominal-io.github.io/instrumentation/",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Examples",
          "href": "https://nominal-io.github.io/instrumentation-docs/examples/",
          "icon": "code"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://portal.usepylon.com/nominal"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Demo",
      "href": "https://nominal.io/request-demo"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nominal_io",
      "github": "https://github.com/nominal-io",
      "linkedin": "https://linkedin.com/company/nominal-io"
    }
  }
}
