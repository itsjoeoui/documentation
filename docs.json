          "instrumentation/installation",
          "instrumentation/driver-dependencies",
          "instrumentation/examples"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "instrumentation/publishers",
          "instrumentation/library"
        ]
      },
      {
        "group": "Instruments",
        "pages": [
          "instrumentation/psu",
          "instrumentation/eload",
          "instrumentation/dmm",
          "instrumentation/daq",
          {
            "group": "I2C",
            "pages": [
              "instrumentation/i2c/overview",
              "instrumentation/i2c/system-definition"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "SDK Reference",
          "href": "https://nominal-io.github.io/instrumentation/",
          "icon": "book-open-cover"
